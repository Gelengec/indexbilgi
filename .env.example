# ------------------------------------------------------------------
# INDEXBİLGİ - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# Gizli anahtarları asla depoya (git) eklemeyin.
# ------------------------------------------------------------------

# PostgreSQL bağlantısı (üretimde gerçek sunucu bilgileri)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/indexbilgi?schema=public"

# Oturum imzalama anahtarı - en az 32 karakter rastgele bir değer üretin:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="CHANGE_ME_WITH_A_RANDOM_32_BYTE_SECRET"

# Sitenin herkese açık adresi (SEO, e-posta bağlantıları, ödeme callback)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Next.js dinleme adresi. Üretimde 127.0.0.1 (yalnızca Nginx erişimi).
# Yerelde localhost üzerinden IPv6 sorunsuz çalışsın istiyorsanız "::" kullanın.
APP_HOST="127.0.0.1"
# APP_PORT="3000"

# İlk kurulumda oluşturulacak süper yönetici (sadece seed sırasında kullanılır)
SEED_ADMIN_EMAIL="admin@indexbilgi.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# Demo verisi (kategoriler, ürünler, sayfalar, demo hesaplar).
# Güvenli varsayılan: kapalı. Yerelde demo katalog istiyorsanız "true" yapın.
# Üretimde asla "true" yapmayın; demo hesapların şifreleri herkese açıktır.
SEED_DEMO_DATA="false"

# E-posta (SMTP) - boş bırakılırsa e-posta gönderilmez, sunucu günlüğüne yazılır
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="INDEXBİLGİ <no-reply@indexbilgi.com>"

# Ödeme - test amaçlı sahte sağlayıcı. ÜRETİMDE KESİNLİKLE false olmalıdır.
PAYMENT_MOCK_ENABLED="false"

# iyzico (gerçek anahtarlar verilene kadar entegrasyon pasiftir)
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# PayTR (gerçek anahtarlar verilene kadar entegrasyon pasiftir)
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""

# Görsel yükleme dizini (sunucuda yazılabilir olmalı)
UPLOAD_DIR="./public/uploads"

# PDF Türkçe karakter fontu (boşsa paket içindeki DejaVuSans kullanılır)
PDF_FONT_PATH=""

# Sysmond TDS - ilk sürümde pasif. Gerçek API dokümanı gelene kadar istek gönderilmez.
# Bu değerler panelde saklanmaz; yalnızca sunucu ortamından okunur.
SYSMOND_BASE_URL=""
SYSMOND_USERNAME=""
SYSMOND_API_KEY=""

# Veritabanı yedeği (npm run db:backup)
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="14"
# pg_dump PATH'te değilse tam yol verin (ör. C:\Program Files\PostgreSQL\16\bin\pg_dump.exe)
PG_DUMP_BIN=""
