{
  "name": "indexbilgi",
  "version": "1.0.0",
  "private": true,
  "description": "INDEXBİLGİ kurumsal teknoloji mağazası - Next.js e-ticaret platformu",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/*.test.ts\"",
    "check:prod": "node --env-file-if-exists=.env scripts/check-prod-env.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:local": "node scripts/local-db.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-db.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "bwip-js": "^4.11.4",
    "clsx": "2.1.1",
    "jose": "5.10.0",
    "lucide-react": "1.72.0",
    "next": "15.5.29",
    "nodemailer": "10.6.0",
    "pdfkit": "^0.20.2",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.3.1",
    "xlsx": "^0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.21",
    "embedded-postgres": "17.11.0-beta.19",
    "postcss": "8.5.33",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
